# ---- App ----
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173

# ---- PostgreSQL — Neon (https://neon.tech, free tier) ----
# Get this from your Neon project's "Connection string" (select the "asyncpg"/
# "Prisma"-style pooled string if offered, otherwise the direct one) and change
# postgresql:// to postgresql+asyncpg://. IMPORTANT: asyncpg needs `ssl=require`,
# NOT the libpq-style `sslmode=require` Neon shows by default.
# Example:
POSTGRES_DATABASE_URL=postgresql+asyncpg://<user>:<password>@<your-project>.neon.tech/<dbname>?ssl=require

# ---- MongoDB — Atlas (https://www.mongodb.com/atlas, free tier) ----
# Get this from Atlas: Database → Connect → Drivers → copy the connection string.
# Example:
MONGODB_URI=mongodb+srv://<user>:<password>@<your-cluster>.mongodb.net/sentinelx?retryWrites=true&w=majority
MONGODB_DB_NAME=sentinelx

# ---- Redis — Upstash (https://upstash.com, free tier) ----
# IMPORTANT: use the TCP "Redis CLI" connection string (rediss://...), NOT the
# REST API URL/token pair — Redis Streams and pub/sub need the real protocol.
# Example:
REDIS_URL=rediss://default:<password>@<your-db>.upstash.io:6379

# ---- OTP ----
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6

# ---- AI / Groq (Phase 17, optional) ----
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---- Threat Intelligence (Phase 8-9, optional external enrichment) ----
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
URLHAUS_API_KEY=
NVD_API_KEY=
